{
  "name": "project-spec-starter",
  "version": "1.0.0",
  "description": "CLI for bootstrapping specification-driven projects",
  "keywords": [
    "cli",
    "project-starter",
    "specification",
    "templates"
  ],
  "homepage": "https://github.com/hellzz13/project-spec-starter#readme",
  "bugs": "https://github.com/hellzz13/project-spec-starter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellzz13/project-spec-starter.git"
  },
  "type": "module",
  "bin": {
    "project-spec-starter": "dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2"
  }
}
